<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>RetroRadio</AssemblyName>
    <RootNamespace>RetroRadio</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>RetroRadio.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NLayer.NAudioSupport" Version="1.4.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Sounds\*.mp3" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Sounds\voice\*.mp3" LogicalName="voice_%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The video converter is its own program in a subfolder. -->
  <ItemGroup>
    <Compile Remove="VideoConverter\**" />
    <None Remove="VideoConverter\**" />
    <EmbeddedResource Remove="VideoConverter\**" />
    <Compile Remove="RadioDesigner\**" />
    <None Remove="RadioDesigner\**" />
    <EmbeddedResource Remove="RadioDesigner\**" />
    <Compile Remove="Launcher\**" />
    <Compile Remove="RetroLens\**" />
    <Compile Remove="RetroDash\**" />
    <None Remove="RetroDash\**" />
    <EmbeddedResource Remove="RetroDash\**" />
    <Compile Remove="JdmGarage\**" />
    <None Remove="JdmGarage\**" />
    <EmbeddedResource Remove="JdmGarage\**" />
    <None Remove="RetroLens\**" />
    <EmbeddedResource Remove="RetroLens\**" />
    <None Remove="Launcher\**" />
    <EmbeddedResource Remove="Launcher\**" />
    <Compile Remove="dist\**" />
    <Compile Remove="Mac\**" />
    <None Remove="Mac\**" />
    <EmbeddedResource Remove="Mac\**" />
    <Compile Remove="Android\**" />
    <None Remove="Android\**" />
    <EmbeddedResource Remove="Android\**" />
    <None Remove="dist\**" />
  </ItemGroup>

  <!-- Hand memory back sooner: the radio keeps little, but starting up makes large short-lived buffers. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

</Project>
