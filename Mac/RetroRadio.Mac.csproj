<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RetroRadio</AssemblyName>
    <RootNamespace>RetroRadio</RootNamespace>
    <Version>1.0.0</Version>
    <DefineConstants>$(DefineConstants);MAC</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0436;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Packager\**;pub\**" />
    <None Remove="Packager\**;pub\**" />
    <Using Include="System.Drawing" />
    <Using Include="System.Windows.Forms" />
    <Compile Include="..\*.cs" Exclude="..\Program.cs;..\ClassicFrame.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NLayer.NAudioSupport" Version="1.4.0" />
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Sounds\*.mp3" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Sounds\voice\*.mp3" LogicalName="voice_%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
